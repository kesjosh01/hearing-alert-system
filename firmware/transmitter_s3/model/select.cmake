# Shared by the product transmitter and the optional LED transmitter.
function(ha_select_s3_model native_model_dir)
    set(HA_S3_MODEL "native40_r06_v1" CACHE STRING "DS-CNN embedded in the transmitter")
    set_property(CACHE HA_S3_MODEL PROPERTY STRINGS native40_r06_v1 domestic_overfit_20261119)

    if(HA_S3_MODEL STREQUAL "native40_r06_v1")
        set(include_dir "${native_model_dir}")
        set(contract "${native_model_dir}/delivered_output_contract.json")
        set(cut_key cuts_integer_units)
    elseif(HA_S3_MODEL STREQUAL "domestic_overfit_20261119")
        set(source_dir "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../../../ml/models/domestic_overfit_20261119")
        set(binary "${source_dir}/esp32s3/model_int8.tflite")
        set(contract "${source_dir}/esp32s3/conversion_report.json")
        set(metadata "${source_dir}/model_metadata.json")
        set(cut_key integer_cuts)
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${binary}" "${metadata}")
        file(READ "${contract}" report)
        string(JSON expected_sha GET "${report}" tflite_sha256)
        file(SHA256 "${binary}" actual_sha)
        if(NOT actual_sha STREQUAL expected_sha)
            message(FATAL_ERROR "Domestic model bytes differ from the conversion report")
        endif()
        file(READ "${metadata}" metadata_json)
        string(JSON frontend_hash GET "${metadata_json}" frontend_sha256)
        file(READ "${binary}" model_hex HEX)
        string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," model_bytes "${model_hex}")
        set(include_dir "${CMAKE_CURRENT_BINARY_DIR}/domestic_model")
        file(MAKE_DIRECTORY "${include_dir}")
        configure_file("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/model_int8.h.in" "${include_dir}/model_int8.h" @ONLY)
    else()
        message(FATAL_ERROR "Unknown HA_S3_MODEL='${HA_S3_MODEL}'. Use native40_r06_v1 or domestic_overfit_20261119.")
    endif()

    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${contract}")
    file(READ "${contract}" model_contract)
    string(JSON fire_cut GET "${model_contract}" "${cut_key}" 0)
    string(JSON bell_cut GET "${model_contract}" "${cut_key}" 1)
    target_include_directories(${COMPONENT_LIB} PRIVATE "${include_dir}")
    target_compile_definitions(${COMPONENT_LIB} PRIVATE HA_MODEL_NAME="${HA_S3_MODEL}"
                               HA_FIRE_CUT=${fire_cut} HA_BELL_CUT=${bell_cut})
    message(STATUS "S3 sound detector: ${HA_S3_MODEL} (fire=${fire_cut}, doorbell=${bell_cut})")
endfunction()
