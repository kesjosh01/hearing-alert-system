menu "Hearing Alert C3 receiver"

    config HA_RX_ALERT_QUEUE_LEN
        int "Accepted-alert queue length (to the UI consumer)"
        range 2 32
        default 8
        help
            An EVENT is ACKed only if it fits in this queue AND a UI consumer is
            attached. Otherwise the S3 keeps retransmitting.

    config HA_RX_LIGHT_SLEEP_DELAY_MS
        int "Enable auto light-sleep after boot [ms]"
        default 15000
        help
            Grace window for USB flashing and boot logs (same as the TEST
            firmware). Wi-Fi MIN_MODEM is active from association.

    config HA_RX_PM_REPORT
        bool "Report SDK light-sleep counters to the S3 (PM_STATS)"
        default y
        help
            Sent together with HELLO every HELLO interval. These counters are
            the evidence of real sleep entry; requires CONFIG_PM_PROFILING.

    config HA_RX_DIAG_LOG_CONSUMER
        bool "DIAGNOSTIC: log-only alert consumer (no UI hardware)"
        default n
        help
            Attaches a consumer that only logs, so radio/ACK tests can run before
            the display/vibration code exists. Not an alert output; never enable
            in a product build.

endmenu
