{
  "version": "yamnet-baseline-v1",
  "protocol_path": "config/training_protocol_v1.json",
  "processed_dir": "data/processed/yamnet_v1",
  "runs_dir": "runs/yamnet",
  "model_handle": "https://tfhub.dev/google/yamnet/1",
  "sample_rate": 16000,
  "minimum_samples": 15600,
  "embedding_dimension": 1024,
  "embedding_unit": "native_yamnet_patch_0.96s_hop_0.48s",
  "short_audio_policy": "right_zero_pad_to_15600_samples",
  "amplitude_policy": "PCM16_to_float32_divide_32768_no_peak_normalization",
  "file_label_policy": "weak_file_label_applied_to_native_patches",
  "clip_prediction": "arithmetic_mean_of_patch_softmax_probabilities",
  "group_prediction": "arithmetic_mean_of_clip_probabilities_within_source_group",
  "hidden_units": 128,
  "dropout": 0.2,
  "learning_rate": 0.001,
  "max_epochs": 30,
  "patience": 8,
  "validation_guards": {
    "max_overseas_other_clip_fpr": 0.05,
    "max_domestic_doorlock_false_positive_groups": 0,
    "note": "Provisional checkpoint-selection limits, not validated product requirements."
  },
  "augmentation": "none_for_first_cached_embedding_baseline",
  "wandb_mode": "disabled"
}
